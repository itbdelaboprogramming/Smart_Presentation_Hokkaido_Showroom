# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=hokkaido_showroom_db

# Session Configuration
SESSION_LIFETIME=1800
SESSION_SECURE=0

# Application Settings
APP_ENV=development
APP_DEBUG=true

# File Upload Limits (in bytes)
MAX_FILE_SIZE=10485760

# Instructions:
# 1. Copy this file to .env
# 2. Fill in your actual database credentials
# 3. For production, set SESSION_SECURE=1 (requires HTTPS)
# 4. For production, set APP_ENV=production and APP_DEBUG=false
